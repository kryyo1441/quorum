# Copy by running `pnpm env:init` (generates fresh keys). Documented here for reference only.
LOG_SECRET_KEY=<base64 32-byte ed25519 secret>
VENDOR_KEY_ID=demo
VENDOR_SECRET_KEY=<base64 32-byte ed25519 secret>
VENDOR_PUBLIC_KEYS='{"demo":"<base64 public key of VENDOR_SECRET_KEY>"}'
LOG_PUBLIC_KEY=<public key of LOG_SECRET_KEY: witnesses, monitor and clients PIN this>
WITNESS_1_SECRET_KEY=<base64 secret>   # also WITNESS_2_SECRET_KEY, WITNESS_3_SECRET_KEY
WITNESS_PUBLIC_KEYS='{"w1":"<pub>","w2":"<pub>","w3":"<pub>"}'
MONITOR_TOKEN=<random>   # writes the approved-release list; deliberately NOT the vendor release key
ADMIN_TOKEN=<random>   # demo-only: lets the demo server clear witness/monitor alerts between runs
